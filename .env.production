APP_NAME=PresenceSync
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# ============================================================
# URL sistem - setelah install, akses via:
# https://presencesync.lokal
# ============================================================
APP_URL=https://presencesync.lokal

LOG_CHANNEL=daily
LOG_LEVEL=error

# ============================================================
# DATABASE (Laragon MySQL)
# Username default Laragon: root, password: kosong
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presencesync
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# CACHE & SESSION (file = tidak perlu Redis)
# ============================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=240

# ============================================================
# MAIL (log saja, tidak kirim email sungguhan)
# ============================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=admin@presencesync.local
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Tidak perlu diubah
# ============================================================
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
