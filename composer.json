{
    "name": "keenthemes/metronic-laravel",
    "type": "project",
    "description": "The Metronic in the Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.8",
        "jackiedo/log-reader": "@dev",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.12",
        "laravel/tinker": "^3.0",
        "mpdf/mpdf": "^8.3",
        "phpoffice/phpspreadsheet": "^5.7",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-permission": "^6.4",
        "yajra/laravel-datatables-buttons": "^13.0",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.0",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "5.x-dev",
        "pestphp/pest-plugin-laravel": "5.x-dev",
        "phpunit/phpunit": "13.1.8",
        "spatie/laravel-ignition": "^2.4"
    },
    "config": {
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./resources/plugins/Laravel-Log-Reader"
        }
    ]
}
